{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/challenge", "destination": "/api/challenge" },
    { "source": "/redeem", "destination": "/api/redeem" },
    { "source": "/verify", "destination": "/api/verify" },
    { "source": "/config", "destination": "/api/config" },
    { "source": "/health", "destination": "/api/health" }
  ]
}
