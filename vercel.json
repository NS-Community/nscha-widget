{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/challenge", "destination": "/api/index" },
    { "source": "/redeem", "destination": "/api/index" },
    { "source": "/verify", "destination": "/api/index" },
    { "source": "/config", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ]
}
