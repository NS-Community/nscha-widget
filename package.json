  },
  "devDependencies": {
    "@cap.js/wasm": "^0.0.8",
    "@cap.js/widget": "^0.1.58",
    "@types/node": "^22.10.2",
    "pako": "2.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
