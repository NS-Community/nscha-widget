# 必填：HS256 签名密钥。用长随机串，轮换会让在途挑战全部失效。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CAP_SECRET="replace-with-a-long-random-hex-string"

# 可选：兑换令牌的签名密钥。留空则复用 CAP_SECRET。
# 若你的业务系统也用 JWT，建议单独设一个，避免两类令牌共用同一把钥匙。
CAP_TOKEN_SECRET=""

# 难度（c × d 决定兑换接口的服务端验算耗时，必须留在函数时间预算内）
CAP_CHALLENGE_COUNT=20
CAP_CHALLENGE_SIZE=32
CAP_CHALLENGE_DIFFICULTY=3

# 时效（秒）
CAP_EXPIRES_SECONDS=600
CAP_TOKEN_TTL_SECONDS=1200

# 用途白名单（逗号分隔，小写）。新增表单要先在这里登记。
CAP_SCOPES="login,register,reset"

# 允许嵌入的站点来源（逗号分隔）。默认 * 表示任何站点都能嵌入；
# 上线后建议收敛成你自己的域名，例如 https://example.com,https://www.example.com
ALLOWED_ORIGIN="*"

# 盒子上的品牌文案与链接
NSCHA_LABEL="NSCHA"
NSCHA_LINK="https://nscha.nsbbs.eu.cc"

# 本地服务端口
PORT=8788
